// Linked List for Inventory Logs
class InventoryLog {
    private LinkedList<String> logs;

    public InventoryLog() {
        logs = new LinkedList<>();
    }

    public void addLog(String log) {
        logs.addFirst(log);
    }

    public void displayLogs() {
        System.out.println("Inventory Logs:");
        for (String log : logs) {
            System.out.println(log);
        }
    }
}
