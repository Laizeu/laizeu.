// Hash Table for searching by Engine Number
class InventoryHashTable {
    private HashMap<String, String> inventory;

    public InventoryHashTable() {
        inventory = new HashMap<>();
    }

    public void addStock(String engineNumber, String brand) {
        inventory.put(engineNumber, brand);
    }

    public String searchStock(String engineNumber) {
        return inventory.getOrDefault(engineNumber, "Stock not found");
    }
}

